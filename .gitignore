# Private and machine state: never in git
context/
.env
.env.*
queue/*.md
queue/drafts/**
!queue/drafts/.gitkeep
runs/
state/
data/
modules/
vault/daily/*
vault/decisions/*
vault/people/*
vault/partners/*
vault/customers/*
!vault/**/.gitkeep
**/.obsidian/workspace*
# Obsidian's own settings change as Jesse uses it; only the daily-notes setting is ours
vault/.obsidian/*
!vault/.obsidian/daily-notes.json
*.zip
private/
CLIENT-CONTEXT.md
client-context/*.md
!client-context/CLIENT-CONTEXT.template.md

# Installed at install time, never committed
tools/.orgo/
.env.local.tmp

# Work-folder outputs and the crew's own templates stay on Jesse's PC
*/output/
people/templates/*
!people/templates/.gitkeep
