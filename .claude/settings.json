{
  "permissions": {
    "allow": [
      "Bash(node tools/setup_orgo.mjs)",
      "PowerShell(node tools/setup_orgo.mjs)",
      "Bash(node tools/build_subagents.mjs)",
      "PowerShell(node tools/build_subagents.mjs)",
      "Bash(node tools/build_manifest.mjs)",
      "PowerShell(node tools/build_manifest.mjs)",
      "Bash(node tools/check.mjs)",
      "PowerShell(node tools/check.mjs)"
    ],
    "deny": [
      "Read(./.env.local)",
      "Read(./.env)",
      "Edit(./.env.local)",
      "Write(./.env.local)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(./tools/**)",
      "Write(./tools/**)",
      "Edit(./policies/**)",
      "Write(./policies/**)",
      "Edit(./state/approvals/**)",
      "Write(./state/approvals/**)",
      "Edit(./state/pending/**)",
      "Write(./state/pending/**)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(orgo:*)",
      "Bash(npx orgo:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/tools/hooks/stop_guard.mjs\"" }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/tools/hooks/stop_guard.mjs\"" }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/tools/hooks/stop_guard.mjs\"" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/tools/hooks/secret_scan.mjs\"" },
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/tools/hooks/approval_capture.mjs\"" }
        ]
      }
    ]
  }
}
