{
  "permissions": {
    "deny": [
      "Read(./.env.local)",
      "Read(./.env)",
      "Edit(./.env.local)",
      "Write(./.env.local)",
      "Edit(./.claude/settings.json)",
      "Write(./.claude/settings.json)",
      "Edit(./tools/hooks/**)",
      "Write(./tools/hooks/**)",
      "Edit(./state/approvals/**)",
      "Write(./state/approvals/**)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(orgo:*)",
      "Bash(npx orgo:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/tools/hooks/stop_guard.mjs\"" }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/tools/hooks/stop_guard.mjs\"" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/tools/hooks/secret_scan.mjs\"" },
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/tools/hooks/approval_capture.mjs\"" }
        ]
      }
    ]
  }
}
